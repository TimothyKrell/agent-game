{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "succession-provider-fixture",
  "main": "fixtures/succession-provider-worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__fixture/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-game",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MATCHES", "class_name": "SuccessionProviderMatch" },
      { "name": "MATCHMAKING", "class_name": "SuccessionProviderCoordinator" },
      { "name": "HOUSE_SEATS", "class_name": "SuccessionProviderHouse" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SuccessionProviderMatch",
        "SuccessionProviderCoordinator",
        "SuccessionProviderHouse",
      ],
    },
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_URL": "https://provider.example.test",
    "HOUSE_PROVIDER": "openai",
    "HOUSE_MODEL": "gpt-4.1-mini",
    "OPENAI_BASE_URL": "http://127.0.0.1:1/v1",
    "OPENAI_API_KEY": "fixture-only-never-a-real-key",
    "TIME_SCALE": "0.4",
    "QUEUE_WAIT_SECONDS": "30",
    "MAX_CONCURRENT_MATCHES": "3",
    "HOUSE_DAILY_BUDGET_USD": "5",
    "HOUSE_MATCH_RESERVATION_USD": "1.5",
  },
}
