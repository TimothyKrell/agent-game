# Production infrastructure values. Supply through your shell or secret manager.
CLOUDFLARE_ACCOUNT_ID=
APP_URL=
# Defaults to agent-game; APP_DOMAIN is optional for a Cloudflare-managed custom hostname.
WORKER_NAME=agent-game
APP_DOMAIN=
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Selected from the local live evaluation; see remaining launch checks in docs/build-status.md.
HOUSE_PROVIDER=workers-ai
HOUSE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENAI_API_KEY=
MAX_CONCURRENT_MATCHES=3
HOUSE_DAILY_BUDGET_USD=5
HOUSE_MATCH_RESERVATION_USD=1.5
