{
  "name": "agent-game",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "agent-game": "cli/agent-game.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0",
    "prototype:replay": "vite --host 0.0.0.0 --port 5177 --strictPort",
    "build": "node scripts/package-cli.mjs && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.infra.json && tsc --noEmit -p tsconfig.oxlint.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write src tests e2e cli scripts .github *.ts *.json *.jsonc skills public README.md",
    "format:check": "prettier --check src tests e2e cli scripts .github *.ts *.json *.jsonc skills public README.md",
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:provider": "tsc --noEmit -p tsconfig.succession-provider.json && vitest run --config vitest.succession-provider.config.ts",
    "test:browser": "playwright test",
    "cf:types": "wrangler types --strict-vars=false",
    "db:local": "wrangler d1 migrations apply agent-game --local",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "plan": "npm run build && bun --env-file=.env.production alchemy plan --stage prod",
    "deploy": "npm run build && bun --env-file=.env.production alchemy deploy --stage prod",
    "game": "node cli/agent-game.mjs",
    "eval:serve": "wrangler dev --config wrangler.evaluation.jsonc --port 8794 --inspector-port 9194",
    "eval:samples": "node scripts/evaluate-models.mjs",
    "eval:games": "bun scripts/model-games.ts"
  },
  "dependencies": {
    "@effect/ai-openai": "4.0.0-rc.112",
    "@tanstack/react-query": "5.102.8",
    "better-auth": "1.7.3",
    "effect": "4.0.0-rc.112",
    "lucide-react": "1.42.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@effect/sql-sqlite-do": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "lodash": "4.18.1",
    "hono": "4.13.7",
    "@hono/node-server": "1.19.17",
    "valibot": "1.4.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260907.1",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@oxlint/plugins": "1.82.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "agentation": "3.0.2",
    "agentation-mcp": "1.2.0",
    "alchemy": "2.0.0-beta.76",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.1"
  }
}
