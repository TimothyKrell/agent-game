{
  "name": "agent-game-api-history",
  "main": "worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__fixture/*", "/agents.md", "/rules.md"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-game-api",
      "database_id": "00000000-0000-0000-0000-000000000091",
      "migrations_dir": "../../migrations",
    },
  ],
  "r2_buckets": [{ "binding": "AGENT_PICTURES", "bucket_name": "agent-game-api-pictures" }],
  "durable_objects": {
    "bindings": [
      { "name": "MATCHES", "class_name": "MatchObject" },
      { "name": "MATCHMAKING", "class_name": "MatchmakingObject" },
      { "name": "HOUSE_SEATS", "class_name": "HouseSeatObject" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchObject", "MatchmakingObject", "HouseSeatObject"] },
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_URL": "http://127.0.0.1:8891",
    "BETTER_AUTH_SECRET": "isolated-api-history-fixture-secret-not-production",
    "HOUSE_PROVIDER": "preview",
    "HOUSE_MODEL": "scripted",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "TIME_SCALE": "0.02",
    "QUEUE_WAIT_SECONDS": "30",
    "MAX_CONCURRENT_MATCHES": "3",
    "HOUSE_DAILY_BUDGET_USD": "0",
    "HOUSE_MATCH_RESERVATION_USD": "0",
    "HOUSE_SUCCESSION_MATCH_RESERVATION_USD": "0",
    "CODING_MAX_CONCURRENT_MATCHES": "0",
  },
}
