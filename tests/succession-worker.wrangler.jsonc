{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "succession-worker-integration",
  "main": "fixtures/succession-worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "succession-worker-test",
      "database_id": "00000000-0000-0000-0000-000000000011",
      "migrations_dir": "../migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MATCHES", "class_name": "MatchObject" },
      { "name": "TEST_MATCHES", "class_name": "MatchObject" },
      { "name": "MATCHMAKING", "class_name": "MatchmakingObject" },
      { "name": "TEST_QUEUE", "class_name": "MatchmakingObject" },
      { "name": "HOUSE_SEATS", "class_name": "HouseSeatObject" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchObject", "MatchmakingObject", "HouseSeatObject"] },
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_URL": "http://localhost:8790",
    "HOUSE_PROVIDER": "preview",
    "HOUSE_MODEL": "integration-scripted",
    "OPENAI_BASE_URL": "http://127.0.0.1:1",
    "TIME_SCALE": "1",
    "QUEUE_WAIT_SECONDS": "30",
    "MAX_CONCURRENT_MATCHES": "3",
    "HOUSE_DAILY_BUDGET_USD": "5",
    "HOUSE_MATCH_RESERVATION_USD": "1.5",
  },
}
