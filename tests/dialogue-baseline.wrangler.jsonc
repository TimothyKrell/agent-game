{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tim-7-dialogue-local-only",
  "main": "fixtures/dialogue-baseline-worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "MATCHES", "class_name": "DialogueMatch" },
      { "name": "HOUSE_SEATS", "class_name": "DialogueHouse" },
      { "name": "MATCHMAKING", "class_name": "DialogueCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DialogueMatch", "DialogueHouse", "DialogueCoordinator"] },
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "HOUSE_DAILY_BUDGET_USD": "5",
    "HOUSE_MATCH_RESERVATION_USD": "1.5",
    "OPENAI_BASE_URL": "http://127.0.0.1:1/v1",
    "OPENAI_API_KEY": "fixture-only-never-a-real-key",
  },
}
